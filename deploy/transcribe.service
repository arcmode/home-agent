[Unit]
Description=Home agent speech to text
After=network-online.target

[Service]
Type=simple
ExecStart=%h/code/home-agent/.venv/bin/python %h/code/home-agent/transcribe/server.py
Environment=HOME=%h
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=TRANSCRIBE_HOST=127.0.0.1
Environment=TRANSCRIBE_PORT=8178
Environment=TRANSCRIBE_MODEL=small
Environment=TRANSCRIBE_DEVICE=cpu
Environment=TRANSCRIBE_COMPUTE=int8
Environment=TRANSCRIBE_CPU_THREADS=4
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
